# ===== 复制为 .env 后填写；.env 不进 git =====

# --- 数据库 ---
POSTGRES_USER=kb
POSTGRES_PASSWORD=改成长随机串
POSTGRES_DB=kb

# --- 对外 ---
API_PORT=8000
# 平台 edge 已终结 TLS 时保持 true（Cookie Secure + HSTS）
COOKIE_SECURE=true
ENABLE_HSTS=true

# --- LLM（OpenAI 兼容；key 部署时注入，不进代码/库） ---
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat

# --- Embedding：local（worker 内 bge-small-zh-v1.5）或 openai_compat ---
EMBEDDING_PROVIDER=local
# openai_compat 时填写（如智谱：https://open.bigmodel.cn/api/paas/v4 + embedding-3）：
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=512
EMBEDDING_API_SEND_DIMS=false

# --- Dify 回调（第二阶段；留空=禁用） ---
DIFY_SERVICE_KEY=

# --- 限流（默认值见 backend/app/config.py，可覆盖） ---
# RL_LOGIN_LIMIT=5
# RL_REVEAL_LIMIT=20
# RL_CHAT_LIMIT=30
